# AI tư vấn (tùy chọn — không có key nào thì rơi về luật local trong assistant.py):
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Facebook Messenger — mỗi store demo (default/shop2/chao) có Page riêng, đọc lúc import
# (stores.py). Fallback chung khi không cấu hình theo store:
PAGE_ACCESS_TOKEN=
VERIFY_TOKEN=commerce-verify

FB_PAGE_ID_DEFAULT=
PAGE_ACCESS_TOKEN_DEFAULT=
FB_PAGE_ID_SHOP2=
PAGE_ACCESS_TOKEN_SHOP2=
FB_PAGE_ID_CHAO=
PAGE_ACCESS_TOKEN_CHAO=

# URL public (qua tunnel) để bấm ảnh sản phẩm mở trang có gallery đầy đủ (engine.py).
PUBLIC_BASE_URL=

# Zalo OA — khung webhook /webhook/zalo-oa CHƯA có tài liệu chính thức (placeholder,
# xem CLAUDE.md/kế hoạch multi-tenant câu 3), chỉ ignore mọi request tới khi có tài liệu.
VERIFY_TOKEN_ZALO_OA=

# Kênh Zalo cá nhân — sidecar commerce/zalo-bridge/ relay tin qua POST /channels/zalo/message.
# ZALO_BRIDGE_SECRET (tùy chọn): shared secret, sidecar gửi kèm header X-Bridge-Secret;
# rỗng = không kiểm (trust boundary chính là bind localhost 2 chiều, xem CLAUDE.md câu 11).
ZALO_BRIDGE_SECRET=
# ZALO_BRIDGE_URL: chưa dùng ở code hiện tại (chưa làm proxy xem QR qua commerce — câu 17
# trong kế hoạch, để lần sau); giữ chỗ cho việc đó.
# ZALO_BRIDGE_URL=http://localhost:4102
