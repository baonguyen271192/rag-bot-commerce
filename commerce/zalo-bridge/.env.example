COMMERCE_URL=http://localhost:8200
# STATUS_PORT — cổng HTTP API trạng thái (QR/logout) của sidecar này, mặc định 4102
# (khác 4002 của bridge/ gốc để chạy song song không đụng cổng nếu cần).
STATUS_PORT=4102
# DATA_DIR — nơi lưu credentials/QR mỗi store, mặc định commerce/zalo-bridge/data
# (tách hẳn khỏi bridge/data/ của hệ Zalo RAG cũ).
# DATA_DIR=./data
# ZALO_BRIDGE_SECRET (tuỳ chọn) — shared secret gửi kèm header X-Bridge-Secret khi gọi
# commerce (POST /channels/zalo/message). Bind localhost là biện pháp chính; secret này
# là lớp phòng vệ thêm (xem CLAUDE.md / kế hoạch câu 11).
# ZALO_BRIDGE_SECRET=
